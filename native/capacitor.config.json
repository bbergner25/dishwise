{
  "appId": "app.everychef.ios",
  "appName": "Every Chef",
  "webDir": "www",
  "server": {
    "url": "https://everychef.app",
    "allowNavigation": ["everychef.app", "*.everychef.app", "clerk.everychef.app", "accounts.everychef.app"]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1A1F2E",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "backgroundColor": "#1A1F2E" },
    "StatusBar": { "style": "DARK", "backgroundColor": "#1A1F2E", "overlaysWebView": false }
  }
}
